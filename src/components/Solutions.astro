---
import Image from "astro/components/Image.astro";
import solution1 from "../assets/solution1.webp";
import solution2 from "../assets/solution2.webp";
import solution3 from "../assets/solution3.webp";
import solution4 from "../assets/solution4.webp";
---

<section
  class="pt-30 pb-20 rounded-bl-xl rounded-br-[100px] md:rounded-bl-xl md:rounded-br-[100px] bg-[#014349] text-white mb-30"
>
  <section class="px-4 lg:px-0">
    <div class="mb-2 w-full lg:w-265 mx-auto">
      <div class="w-full md:w-150 text-center">
        <h2 class="text-3xl font-semibold mb-4">
          Managed By People Who Understand Eco Tourism Operations
        </h2>
        <span class="block font-light">
          With hands-on experience in eco tourism operations and travel booking
          workflows, we understand the real challenges behind converting
          interest into confirmed reservations.
        </span>
      </div>
    </div>
  </section>

  <section class="px-4 lg:px-0 py-12">
    <div class="w-full lg:w-265 mx-auto">
      <!-- Row 1: image | content -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-1 md:order-1">
          <Image src={solution1} alt="Solution 1" />
        </div>
        <div class="order-2 md:order-2">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Web Design &amp; Development
          </h3>
          <div class="mb-4">
            <p>
              We create modern websites that are fast, scalable, and built
              around real business objectives.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn more</a>
          </div>
        </div>
      </div>

      <!-- Row 2: content | image (BUT mobile must be image first) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-2 md:order-1">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Custom Software Development
          </h3>
          <div class="mb-4">
            <p>
              We build digital tools and platforms that help organizations
              improve operations and customer experiences.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn more</a>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <Image src={solution2} alt="Solution 2" />
        </div>
      </div>

      <!-- Row 3: image | content -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-1 md:order-1">
          <Image src={solution3} alt="Solution 3" />
        </div>
        <div class="order-2 md:order-2">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Business Systems &amp; Automation
          </h3>
          <div class="mb-4">
            <p>
              We connect workflows, customer interactions, and operational
              processes into efficient digital systems.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn more</a>
          </div>
        </div>
      </div>

      <!-- Row 4: content | image -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="order-2 md:order-1">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Search & Discoverability
          </h3>
          <div class="mb-4">
            <p>
              We structure digital experiences to be discoverable through search
              engines and other digital channels.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn more</a>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <Image src={solution4} alt="Solution 4" />
        </div>
      </div>
    </div>
  </section>
</section>
