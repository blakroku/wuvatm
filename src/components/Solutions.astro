---
import Image from "astro/components/Image.astro";
import solution1 from "../assets/solution1.webp";
import solution2 from "../assets/solution2.webp";
import solution3 from "../assets/solution3.webp";
import solution4 from "../assets/solution4.webp";
---

<section
  class="pt-30 pb-20 rounded-bl-xl rounded-br-[100px] md:rounded-bl-xl md:rounded-br-[100px] bg-[#014349] text-white mb-30"
>
  <section class="px-4 lg:px-0">
    <div class="mb-2 w-full lg:w-265 mx-auto">
      <div class="w-full md:w-150">
        <h2 class="text-3xl font-semibold mb-4">
          Built By People Who Understand Tourism
        </h2>
        <span class="block font-light">
          With hands-on experience in eco-tour operations and travel booking
          workflows, we understand the real challenges behind converting
          interest into confirmed reservations.
        </span>
      </div>
    </div>
  </section>

  <section class="px-4 lg:px-0 py-12">
    <div class="w-full lg:w-265 mx-auto">
      <!-- Row 1: image | content -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-1 md:order-1">
          <Image src={solution1} alt="Solution 1" />
        </div>
        <div class="order-2 md:order-2">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Turn More Visitors Into Guests
          </h3>
          <div class="mb-4">
            <p>
              Your website should do more than look beautiful. We design
              booking-focused websites that help travelers find the information
              they need, build trust quickly, and book directly with confidence.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn more</a>
          </div>
        </div>
      </div>

      <!-- Row 2: content | image (BUT mobile must be image first) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-2 md:order-1">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Rank Where Travelers Are Searching
          </h3>
          <div class="mb-4">
            <p>
              When travelers search for eco-lodges, safari experiences,
              sustainable travel, or nature-based adventures, your business
              should be visible. We optimize your website to attract high-intent
              visitors before they book through OTAs or competitors.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn more</a>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <Image src={solution2} alt="Solution 2" />
        </div>
      </div>

      <!-- Row 3: image | content -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-1 md:order-1">
          <Image src={solution3} alt="Solution 3" />
        </div>
        <div class="order-2 md:order-2">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Reduce Dependence on OTAs
          </h3>
          <div class="mb-4">
            <p>
              Every booking that comes through your own website means stronger
              guest relationships and fewer commission fees. We build direct
              booking experiences that make it easy for travelers to inquire,
              reserve, and pay without leaving your website.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn more</a>
          </div>
        </div>
      </div>

      <!-- Row 4: content | image -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="order-2 md:order-1">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Convert More Inquiries Through WhatsApp
          </h3>
          <div class="mb-4">
            <p>
              Many travelers have questions before they book. We help eco
              tourism operators automate responses, qualify leads, and guide
              guests through the booking process using WhatsApp, without losing
              the personal touch that makes hospitality special.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn more</a>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <Image src={solution4} alt="Solution 4" />
        </div>
      </div>
    </div>
  </section>
</section>
