---
import Image from "astro/components/Image.astro";
import solution1 from "../assets/solution1.webp";
import solution2 from "../assets/solution2.webp";
import solution3 from "../assets/solution3.webp";
import solution4 from "../assets/solution4.webp";
---

<section
  class="pt-30 pb-20 rounded-bl-xl rounded-br-[100px] md:rounded-bl-xl md:rounded-br-[100px] bg-[#014349] text-white mb-30"
>
  <section class="px-4 lg:px-0">
    <div class="mb-2 w-full lg:w-265 mx-auto">
      <div class="w-full md:w-150">
        <h2 class="text-3xl font-semibold mb-4">
          How WuvaTM Grows Your Eco Tourism Business
        </h2>
        <span class="block font-light">
          At WuvaTM, we are passionate about helping eco tourism businesses
          thrive in the digital age. Our innovative solutions and data-driven
          strategies have empowered our clients to achieve remarkable results
        </span>
      </div>
    </div>
  </section>

  <section class="px-4 lg:px-0 py-12">
    <div class="w-full lg:w-265 mx-auto">
      <!-- Row 1: image | content -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-1 md:order-1">
          <Image src={solution1} alt="Solution 1" />
        </div>
        <div class="order-2 md:order-2">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            High Converting Web Design & Redesign
          </h3>
          <div class="mb-4">
            <p>
              We create visually stunning and user-friendly websites that
              captivate visitors and drive conversions. Our designs are
              optimized for performance, ensuring fast load times and seamless
              navigation.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn More</a>
          </div>
        </div>
      </div>

      <!-- Row 2: content | image (BUT mobile must be image first) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-2 md:order-1">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            SEO & Organic Booking Growth
          </h3>
          <div class="mb-4">
            <p>
              Our SEO strategies are designed to boost your online visibility
              and drive organic traffic to your website. We conduct thorough
              keyword research, optimize on-page elements, and build
              high-quality backlinks to improve your search engine rankings.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn More</a>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <Image src={solution2} alt="Solution 2" />
        </div>
      </div>

      <!-- Row 3: image | content -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-30">
        <div class="order-1 md:order-1">
          <Image src={solution3} alt="Solution 3" />
        </div>
        <div class="order-2 md:order-2">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Direct Booking System
          </h3>
          <div class="mb-4">
            <p>
              We develop and implement direct booking systems that allow your
              customers to book directly through your website, eliminating the
              need for third-party platforms and reducing commission fees. Our
              systems are user-friendly and secure, providing a seamless booking
              experience for your customers.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn More</a>
          </div>
        </div>
      </div>

      <!-- Row 4: content | image -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="order-2 md:order-1">
          <h3 class="text-sm uppercase tracking-widest mb-6">
            Whatsapp Booking Automation
          </h3>
          <div class="mb-4">
            <p>
              Our WhatsApp booking automation solution allows your customers to
              easily book their eco tourism experiences through WhatsApp. This
              convenient and popular messaging platform enables you to engage
              with your customers in real-time, providing instant responses and
              streamlining the booking process.
            </p>
          </div>
          <div class="mt-12">
            <a class="btn-small" href="">Learn More</a>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <Image src={solution4} alt="Solution 4" />
        </div>
      </div>
    </div>
  </section>
</section>
