---
import { Image } from "astro:assets";
import Lead2 from "../assets/lead-2.png";
---

<section class="hidden">proof</section>

<section class="pt-22 pb-30 text-white px-4 lg:px-0">
  <div
    class="w-full text-center lg:text-left lg:w-265 mx-auto bg-[#014349] rounded-tl-[100px] rounded-br-[100px] md:rounded-4xl flex flex-col lg:flex-row items-center gap-10 px-10 py-16"
  >
    <div>
      <h2 class="font-bold text-5xl">
        Not Sure Why Travelers Aren't Booking Directly?
      </h2>
      <div class="mt-8">
        <span>
          We'll identify the gaps in your website, booking journey, and
          marketing strategy that may be costing you bookings.
        </span>
      </div>
      <div class="mt-12">
        <a class="btn-large hover:border-2 hover:border-[#42FF87]" href=""
          >Request Your Free Growth Audit</a
        >
      </div>
    </div>
    <div class="hidden lg:block">
      <span>
        <Image src={Lead2} alt="WuvaTM dashboard preview" width={1000} />
      </span>
    </div>
  </div>
</section>
