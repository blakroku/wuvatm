---
import TickIcon from "./icons/TickIcon.astro";
---

<section class="">
  <section class="mb-16 px-4 lg:px-0">
    <div class="mb-2 text-center w-full lg:w-265 mx-auto">
      <h2 class="text-3xl font-semibold">
        A Proven Framework For Increasing Direct Bookings
      </h2>
      <h3 class="mt-4">
        We don't guess. We start with data, then improve what matters most.
        Every step is designed to increase direct bookings and reduce friction
        in the guest journey.
      </h3>
    </div>
  </section>

  <section class="mb-32 px-4 lg:px-0 bg-[#F3EBE4]">
    <div class="w-full lg:w-265 mx-auto">
      <div class="px-4">
        <div class="grid grid-cols-2">
          <div
            class="flex flex-col gap-3 py-10 pr-10 border-r border-b border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Audit & Diagnose
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We identify friction points in your website, booking flow, and
              guest journey.
            </span>
          </div>

          <div
            class="flex flex-col gap-3 py-10 pl-10 border-b border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Prioritize Growth Opportunities
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We focus on the improvements most likely to increase inquiries and
              bookings.
            </span>
          </div>

          <div
            class="flex flex-col gap-3 py-10 pr-10 border-r border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Implement &amp; Optimize
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              From website improvements to SEO and automation, we execute the
              highest-impact changes.
            </span>
          </div>

          <div class="flex flex-col gap-3 py-10 pl-10">
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Measure &amp; Improve
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We continuously refine performance based on real visitor behavior
              and booking data.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</section>
