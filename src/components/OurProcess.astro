---
import TickIcon from "./icons/TickIcon.astro";
---

<section class="">
  <section class="mb-16 px-4 lg:px-0">
    <div class="mb-2 text-center w-full lg:w-265 mx-auto">
      <h2 class="text-3xl font-semibold">
        A Proven Booking System For Eco Tourism Growth
      </h2>
      <h3 class="mt-4">
        We don’t experiment on your business. We deploy a structured tour
        distribution and booking system that is already designed to convert
        interest into confirmed bookings across website, WhatsApp, and social
        media.
      </h3>
    </div>
  </section>

  <section class="mb-32 px-4 lg:px-0 bg-[#F3EBE4]">
    <div class="w-full lg:w-265 mx-auto">
      <div class="px-4">
        <div class="grid grid-cols-2">
          <div
            class="flex flex-col gap-3 py-10 pr-10 border-r border-b border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              System Setup &amp; Audit
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We connect your existing assets (website, social media, WhatsApp)
              into a unified tour and booking structure.
            </span>
          </div>

          <div
            class="flex flex-col gap-3 py-10 pl-10 border-b border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Tour System Deployment
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              Your tours are structured into standardized booking assets that
              can be distributed and tracked across all channels.
            </span>
          </div>

          <div
            class="flex flex-col gap-3 py-10 pr-10 border-r border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Booking &amp; WhatsApp Integration
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We activate the booking engine and connect WhatsApp so inquiries
              and bookings are captured automatically inside one system.
            </span>
          </div>

          <div class="flex flex-col gap-3 py-10 pl-10">
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Tracking &amp; Optimization
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We monitor booking performance per tour and per channel to
              continuously improve conversion rates.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</section>
