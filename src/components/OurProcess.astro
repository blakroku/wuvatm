---
import TickIcon from "./icons/TickIcon.astro";
---

<section class="">
  <section class="mb-16 px-4 lg:px-0">
    <div class="mb-2 text-center w-full lg:w-265 mx-auto">
      <h2 class="text-3xl font-semibold">
        A Clear Process for Increasing Direct Bookings
      </h2>
      <h3 class="mt-4">
        We don't guess. We start with data, then improve what matters most.
      </h3>
    </div>
  </section>
  <section class="mb-32 px-4 lg:px-0 bg-[#F3EBE4]">
    <div class="w-full lg:w-265 mx-auto">
      <div class="px-4">
        <div class="grid grid-cols-2">
          <div
            class="flex flex-col gap-3 py-22 pr-10 border-r border-b border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Audit & Diagnose
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We analyze your website, SEO performance, and booking journey to
              identify exactly where guests drop off.
            </span>
          </div>

          <div
            class="flex flex-col gap-3 py-22 pl-10 border-b border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Strategy & Prioritization
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We map out the highest impact improvements, what will increase
              bookings fastest.
            </span>
          </div>

          <div
            class="flex flex-col gap-3 py-22 pr-10 border-r border-white border-dashed"
          >
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Build or Optimize
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We implement changes through design, SEO, or conversion
              improvements depending on your needs.
            </span>
          </div>

          <div class="flex flex-col gap-3 py-22 pl-10">
            <div>
              <TickIcon />
            </div>
            <h3 class="font-semibold text-lg text-foreground">
              Improve Conversion
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              Your website becomes easier to trust, easier to find, and easier
              to book.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</section>
