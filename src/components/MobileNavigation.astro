<section
  class="lg:hidden bg-white absolute left-0 right-0 top-16 shadow-lg z-10 p-5 flex flex-col gap-6"
  x-show="expandMobileNavigation"
  @click.away="expandMobileNavigation = false"
  x-collapse
>
  <div class="">
    <ul class="flex flex-col gap-6">
      <li>
        <button
          class="flex gap-2 items-center cursor-pointer"
          @click="expandSolutions = !expandSolutions"
        >
          <span>Booking Growth Framework</span>
          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="3.5"
              stroke="currentColor"
              class="size-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
            </svg>
          </span>
        </button>
        <div
          class="bg-white"
          id="expandSolutions"
          x-show="expandSolutions"
          x-collapse
          @click.away="expandSolutions = false"
        >
          <div class="py-4 flex flex-col gap-6">
            <div>
              <a
                href="solutions/high-converting-web-design-redesign"
                class="text-md hover:underline font-medium text-gray-900"
              >
                High-Converting Websites &amp; Redesign
              </a>
              <p class="text-sm text-gray-500">
                High-converting tourism websites built to increase direct
                bookings.
              </p>
            </div>
            <div>
              <a
                href="solutions/seo-organic-booking-growth"
                class="text-md hover:underline font-medium text-gray-900"
              >
                SEO &amp; Organic Booking Growth
              </a>
              <p class="text-sm text-gray-500">
                Rank higher on Google and attract more travel bookings.
              </p>
            </div>
            <div>
              <a
                href="solutions/direct-booking-system"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Direct Booking System
              </a>
              <p class="text-sm text-gray-500">
                Manage website, social, and agent bookings from one centralized
                dashboard.
              </p>
            </div>
            <div>
              <a
                href="solutions/whatsapp-booking-automation"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Whatsapp Booking Automation
              </a>
              <p class="text-sm text-gray-500">
                Discover what's hurting conversions and get a clear growth
                strategy.
              </p>
            </div>
          </div>
        </div>
      </li>
      <li>
        <button
          class="flex gap-2 items-center cursor-pointer"
          @click="expandIndustries = !expandIndustries"
        >
          <span>Who We Work With</span>
          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="3.5"
              stroke="currentColor"
              class="size-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
            </svg>
          </span>
        </button>
        <div
          class="bg-white"
          id="expandIndustries"
          x-show="expandIndustries"
          x-collapse
          @click.away="expandIndustries = false"
        >
          <div class="py-4 flex flex-col gap-6">
            <div>
              <a
                href="industries/safari-lodges-eco-resorts"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Safari Lodges &amp; Eco Resorts
              </a>
              <p class="text-sm text-gray-500">
                Luxury and sustainable accommodations targeting international
                travelers.
              </p>
            </div>
            <div>
              <a
                href="industries/tour-operators-dmcs"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Tour Operators &amp; DMCs
              </a>
              <p class="text-sm text-gray-500">
                Multi-day tours, safaris, cultural trips, and travel
                coordination services.
              </p>
            </div>
            <div>
              <a
                href="industries/agritourism-farm-stays"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Agritourism &amp; Farm Stays
              </a>
              <p class="text-sm text-gray-500">
                Farm tours, coffee trails, culinary tourism, and sustainable
                agriculture experiences.
              </p>
            </div>
            <div>
              <a
                href="industries/adventure-tour-companies"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Adventure &amp; Tour Companies
              </a>
              <p class="text-sm text-gray-500">
                Hiking, kayaking, surfing, canopy walks, and outdoor
                experiences.
              </p>
            </div>
          </div>
        </div>
      </li>
    </ul>
  </div>
  <div class="">
    <ul class="flex flex-col gap-3">
      <li>
        <button
          class="flex gap-2 items-center cursor-pointer"
          @click="expandResources = !expandResources"
        >
          <span>Resources</span>
          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="3.5"
              stroke="currentColor"
              class="size-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
            </svg>
          </span>
        </button>
        <div
          class="bg-white"
          id="expandResources"
          x-show="expandResources"
          x-collapse
          @click.away="expandResources = false"
        >
          <div class="py-4 flex flex-col gap-6">
            <div>
              <a
                href="about"
                class="text-md hover:underline font-medium text-gray-900"
              >
                About Us
              </a>
              <p class="text-sm text-gray-500">
                Learn about our mission to help African tourism brands grow
                online.
              </p>
            </div>
            <div>
              <a
                href="case-studies"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Case Studies
              </a>
              <p class="text-sm text-gray-500">
                Real tourism website and SEO success stories from across Africa.
              </p>
            </div>
            <div>
              <a
                href="blog"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Blog
              </a>
              <p class="text-sm text-gray-500">
                Actionable SEO, web design, and digital growth insights for
                tourism businesses.
              </p>
            </div>
            <div>
              <a
                href="knowledge-base"
                class="text-md hover:underline font-medium text-gray-900"
              >
                Knowledge Base
              </a>
              <p class="text-sm text-gray-500">
                Answers to questions about our process, SEO services, and
                booking platform integrations.
              </p>
            </div>
          </div>
        </div>
      </li>
      <li class="block w-full mt-6">
        <a
          class="flex items-center justify-center gap-2 bg-[#014349] text-[#42FF87] hover:bg-[#42FF87] hover:text-[#014349] rounded-lg px-6 py-3"
          href="/contact-wuvatec"
        >
          <span>Support</span>
          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"
              ></path>
            </svg>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>
