---
import Branding from "../components/Branding.astro";
import MobileNavigation from "../components/MobileNavigation.astro";
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-inherit"
  x-data="{ expandSolutions: false, expandIndustries: false, expandResources: false, expandMobileNavigation: false }"
>
  <nav
    class="flex justify-between items-center p-5 lg:py-6 w-full lg:w-265 lg:mx-auto"
  >
    <Branding />

    <!-- mobile menu button -->
    <div
      class="lg:hidden bg-[#42FF87] hover:bg-[#014349] hover:text-[#42FF87] rounded-lg p-2"
    >
      <button
        class="flex items-center gap-2 cursor-pointer"
        @click="expandMobileNavigation = !expandMobileNavigation"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="size-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>

        <!-- <span>Menu</span> -->
      </button>
    </div>

    <MobileNavigation />
    <!-- end mobile menu button -->

    <div class="hidden lg:block">
      <ul class="flex gap-10">
        <li>
          <button
            class="flex gap-2 items-center cursor-pointer"
            @click="expandSolutions = !expandSolutions"
          >
            <span>Our Solutions</span>
            <span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="3.5"
                stroke="currentColor"
                class="size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </button>
          <div
            class="bg-white absolute left-0 right-0 top-17 shadow-lg z-10"
            style="width: 100vw; left: 50%; transform: translateX(-50%);"
            id="expandSolutions"
            x-show="expandSolutions"
            x-collapse
            @click.away="expandSolutions = false"
          >
            <div class="w-265 mx-auto px-4 py-8 grid grid-cols-2 gap-5">
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="solutions/high-converting-web-design-redesign"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  High Converting Web Design & Redesign
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    High converting tourism websites built to increase direct
                    bookings.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="solutions/seo-organic-booking-growth"
                  class="text-md hover:underline font-medium text-gray-900"
                  >SEO &amp; Organic Booking Growth</a
                >
                <div>
                  <span class="text-gray-500 text-sm">
                    Rank higher on Google and attract more travel bookings.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="solutions/direct-booking-system"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Direct Booking System
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Manage website, social, and agent bookings from one
                    centralized dashboard.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="solutions/whatsapp-booking-automation"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Whatsapp Booking Automation
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Discover what’s hurting conversions and get a clear growth
                    strategy.
                  </span>
                </div>
              </div>
            </div>
          </div>
        </li>
        <li>
          <button
            class="flex gap-2 items-center cursor-pointer"
            @click="expandIndustries = !expandIndustries"
          >
            <span>Industries We Work With</span>
            <span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="3.5"
                stroke="currentColor"
                class="size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </button>
          <div
            class="bg-white absolute left-0 right-0 top-17 shadow-lg z-10"
            style="width: 100vw; left: 50%; transform: translateX(-50%);"
            id="expandIndustries"
            x-show="expandIndustries"
            x-collapse
            @click.away="expandIndustries = false"
          >
            <div class="w-265 mx-auto px-4 py-8 grid grid-cols-2 gap-5">
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="industries/safari-lodges-eco-resorts"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Safari Lodges &amp; Eco Resorts
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Luxury and sustainable accommodations targeting
                    international travelers.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="industries/tour-operators-dmcs"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Tour Operators &amp; DMCs
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Multi-day tours, safaris, cultural trips, and travel
                    coordination services.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="industries/agritourism-farm-stays"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Agritourism &amp; Farm Stays
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Farm tours, coffee trails, culinary tourism, and sustainable
                    agriculture experiences.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="industries/adventure-tour-companies"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Adventure &amp; Tour Companies
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Hiking, kayaking, surfing, canopy walks, and outdoor
                    experiences.
                  </span>
                </div>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </div>
    <div class="hidden lg:block">
      <ul class="flex gap-8 items-center">
        <li>
          <button
            class="flex gap-2 items-center cursor-pointer"
            @click="expandResources = !expandResources"
          >
            <span>Resources</span>
            <span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="3.5"
                stroke="currentColor"
                class="size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </button>
          <div
            class="bg-white absolute left-0 right-0 top-17 shadow-lg z-10"
            style="width: 100vw; left: 50%; transform: translateX(-50%);"
            id="expandResources"
            x-show="expandResources"
            x-collapse
            @click.away="expandResources = false"
          >
            <div class="w-265 mx-auto px-4 py-8 grid grid-cols-2 gap-5">
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="about"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  About Us
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Learn about our mission to help African tourism brands grow
                    online.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="case-studies"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Case Studies
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Real tourism website and SEO success stories from across
                    Africa.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="blog"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Blog
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Actionable SEO, web design, and digital growth insights for
                    tourism businesses.
                  </span>
                </div>
              </div>
              <div class="hover:bg-[#F9F3EB] p-3 rounded-lg">
                <a
                  href="knowledge-base"
                  class="text-md hover:underline font-medium text-gray-900"
                >
                  Knowledge Base
                </a>
                <div>
                  <span class="text-gray-500 text-sm">
                    Answers to questions about our process, SEO services, and
                    booking platform integrations.
                  </span>
                </div>
              </div>
            </div>
          </div>
        </li>
        <li>
          <a
            class="flex items-center gap-2 border-2 border-[#42FF87] text-[#014349] hover:text-[#014349] hover:bg-[#42FF87] rounded-lg px-6 py-2"
            href="/contact-wuvatec"
          >
            <span>Support</span>
            <span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"
                ></path>
              </svg>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </nav>
  <!-- <section>announcement</section> -->
</header>
