---
import faqs from "../data/faqs.json";
---

<section class="mb-24">
  <section class="px-4 lg:px-0 text-center">
    <div class="mb-2 w-full lg:w-265 mx-auto">
      <div class="w-full mf:w-150">
        <h2 class="text-3xl font-semibold mb-4">Frequently Asked Questions</h2>
        <h3>
          These are common questions from eco-tourism operators looking to
          improve direct bookings and reduce OTA dependence.
        </h3>
      </div>
    </div>
  </section>
  <section class="px-4 lg:px-0 py-12">
    <div class="w-full lg:w-265 mx-auto">
      <section
        x-data="{ active: null, faqs: JSON.parse($el.dataset.faqs) }"
        data-faqs={JSON.stringify(faqs)}
      >
        <template x-for="(faq, index) in faqs" :key="index">
          <div
            class="border-b border-gray-100 bg-white px-10 py-2 rounded-4xl mb-4"
          >
            <button
              @click="active = active === index ? null : index"
              class="flex items-center justify-between w-full py-5 text-left cursor-pointer"
            >
              <span class="font-medium text-lg" x-text="faq.title"></span>

              <span>
                <svg
                  class="w-10 h-10 transition-transform duration-300 bg-[#42FF87] text-[#220629] rounded-full p-3"
                  :class="{ 'rotate-90': active === index }"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="4"
                    d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </button>

            <div
              x-show="active === index"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 max-h-0"
              x-transition:enter-end="opacity-100 max-h-96"
              x-transition:leave="transition ease-in duration-200"
              x-transition:leave-start="opacity-100 max-h-96"
              x-transition:leave-end="opacity-0 max-h-0"
              class="overflow-hidden"
            >
              <div class="pb-5 text-gray-600" x-text="faq.content"></div>
            </div>
          </div>
        </template>
      </section>
    </div>
  </section>
</section>
