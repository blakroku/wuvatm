---
import { Image } from "astro:assets";
import HeroImage from "../assets/hero-3.webp";
---

<section class="bg-[#014349] md:bg-inherit">
  <div
    class="w-full lg:w-265 mx-auto px-8 lg:px-4 pt-40 pb-18 flex justify-between rounded-br-[100px] md:rounded-none items-center gap-12 flex-col lg:flex-row bg-[url('../assets/hero-bg.avif')] md:bg-none bg-cover bg-center bg-no-repeat bg-black md:bg-inherit text-white md:text-inherit"
  >
    <div class="w-full md:w-[50%]">
      <h1 class="font-bold text-5xl">
        <!-- Digital Growth Partner for Eco Tour Operators -->
        Building Digital Products, Websites & Business Systems for Eco Tour Operators
      </h1>
      <div class="mt-8">
        <span>
          Wuva is a technology company that designs, develops, and operates
          digital products that help eco tourism businesses manage their online
          presence, customer interactions, and growth.
        </span>
      </div>
      <div class="my-14">
        <span>
          <a href="#" class="btn-large">Get A Free Audit</a>
        </span>
        <span class="block text-xs mt-8">
          <!-- <span class="block">
            We'll review your website, booking journey, SEO visibility, and
            direct booking opportunities.
          </span> -->
          <span class="block mt-2">
            From custom websites to software platforms, we build technology that
            solves practical business problems.
          </span>
        </span>
      </div>
    </div>
    <div class="w-[50%] hidden lg:block">
      <Image
        src={HeroImage}
        alt="A monkey on a tree branch"
        width={900}
        class="w-full"
      />
    </div>
  </div>
</section>
