---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import GoogleAnalytics from "../components/analytics/google-analytics.astro";
// Meta tags and title are set in each page's frontmatter for better SEO control
const { title } = Astro.props;
const { meta_description } = Astro.props;
const { meta_keywords } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={meta_description} />
    <meta name="keywords" content={meta_keywords} />
    <title>
      {title} | Wuva Technology
    </title>
  </head>

  <!-- <GoogleAnalytics /> -->

  <body>
    <Navigation />

    <slot />

    <Footer />
  </body>

  <style>
    [x-cloak] {
      display: none !important;
    }
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }
  </style>
</html>
