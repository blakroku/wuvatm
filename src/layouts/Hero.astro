---
import { Image } from "astro:assets";

const { hero_title } = Astro.props;
const { hero_description } = Astro.props;
const { you_are_here } = Astro.props;
const { hero_image } = Astro.props;
---

<section class="pt-32 pb-12">
  <div
    class="w-full lg:w-265 mx-auto px-8 lg:px-4 flex justify-between rounded-br-[100px] md:rounded-none items-center gap-12 flex-col lg:flex-row"
  >
    <div class="w-full md:w-[50%]">
      <div
        class="w-full lg:w-265 mx-auto font-light py-4 uppercase text-xs tracking-widest text-[#014349]"
      >
        You are here - {you_are_here}
      </div>
      <h1 class="font-bold text-5xl">
        <!-- Digital Growth Partner for Eco Tour Operators -->
        {hero_title}
      </h1>
      <div class="mt-8">
        <span>
          {hero_description}
        </span>
      </div>
    </div>
    <div class="hidden lg:inline-block">
      <Image src={hero_image} alt={"Alt"} width={} />
    </div>
  </div>
</section>
