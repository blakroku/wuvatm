---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { Image } from "astro:assets";
import Lead2 from "../assets/lead-2.png";
---

<Layout>
  <Hero />

  <section class="hidden">solutions</section>

  <section class="mt-22 mb-32 px-4 py-32 lg:px-0 bg-[#F3F5F4]">
    <div class="w-full lg:w-265 mx-auto">
      <div class="px-4">
        <div class="mb-10">
          <h2 class="text-3xl font-semibold">
            A Clear Process for Increasing Direct Bookings
          </h2>
          <h3>
            We don't guess. We start with data, then improve what matters most.
          </h3>
        </div>

        <div class="grid grid-cols-2">
          <div
            class="flex flex-col gap-3 py-6 pr-10 border-r border-b border-gray-300"
          >
            <h3 class="font-semibold text-lg text-foreground">
              Audit & Diagnose
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We analyze your website, SEO performance, and booking journey to
              identify exactly where guests drop off.
            </span>
          </div>

          <div class="flex flex-col gap-3 py-6 pl-10 border-b border-gray-300">
            <h3 class="font-semibold text-lg text-foreground">
              Strategy & Prioritization
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We map out the highest impact improvements, what will increase
              bookings fastest.
            </span>
          </div>

          <div class="flex flex-col gap-3 py-6 pr-10 border-r border-gray-300">
            <h3 class="font-semibold text-lg text-foreground">
              Build or Optimize
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              We implement changes through design, SEO, or conversion
              improvements depending on your needs.
            </span>
          </div>

          <div class="flex flex-col gap-3 py-6 pl-10">
            <h3 class="font-semibold text-lg text-foreground">
              Improve Conversion
            </h3>
            <span class="text-muted-foreground text-sm leading-relaxed">
              Your website becomes easier to trust, easier to find, and easier
              to book.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="hidden">how we work</section>

  <section class="hidden">proof</section>

  <section class="py-22 text-white px-4 lg:px-0">
    <div
      class="w-full text-center lg:text-left lg:w-265 mx-auto bg-[#416642] rounded-2xl flex flex-col lg:flex-row items-center gap-10 px-10 py-16"
    >
      <div>
        <h2 class="font-bold text-5xl">
          Not Sure Why Your Website Isn't Converting?
        </h2>
        <div class="mt-8">
          <span>
            We'll audit your eco-tourism website and show you exactly what is
            preventing more direct bookings.
          </span>
        </div>
        <div class="mt-12">
          <a class="btn-large" href="">Request Free Audit</a>
        </div>
      </div>
      <div class="hidden lg:block">
        <span>
          <Image src={Lead2} alt="WuvaTM dashboard preview" width={1000} />
        </span>
      </div>
    </div>
  </section>
</Layout>
